# Copie para .env e ajuste. Nunca comite segredos.
CORS_ORIGINS=http://localhost:5173
LOTE_ANO=2026
SOLVER_TIME_LIMIT=30
DESEMPATE_EPSILON=1e-4
OCUPACAO_MINIMA=0.6

# ── Camada LLM (opcional — sem chave, /insight responde 503 e o front recolhe o bloco) ──
# Provedor: "anthropic" (default) ou "nvidia" (NVIDIA NIM, compatível com a API da OpenAI).
LLM_PROVIDER=anthropic
LLM_TIMEOUT_S=8

# Anthropic (quando LLM_PROVIDER=anthropic):
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5

# NVIDIA NIM (quando LLM_PROVIDER=nvidia): pegue a chave e o id do modelo em https://build.nvidia.com
# LLM_PROVIDER=nvidia
# LLM_API_KEY=nvapi-xxxxxxxx          # (ou reuse ANTHROPIC_API_KEY — o código cai para ela)
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1   # confirme o id exato no catálogo NVIDIA
